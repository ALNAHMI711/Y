# Required
DOMAIN=example.com
ADMIN_PHONE=967700000000
# Keep DEV_OTP unset (or 0) in production. With it on, OTP codes are returned in API responses.
# DEV_OTP=0

# WhatsApp Cloud API (OTP + support notifications). Without these, messages are only logged.
# WA_TOKEN=
# WA_PHONE_ID=
# WA_TEMPLATE=
SUPPORT_PHONE=
INGEST_KEY=change-me-long-random

# Optional: AI copilot analysis via Claude
# ANTHROPIC_API_KEY=
# Extra browser origins allowed to call the API (the Android app origin is allowed already)
# CORS_ORIGINS=
BACKUP_KEEP=14
